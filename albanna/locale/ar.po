msgid "Albanna"
msgstr "ألبانا"


msgid "Ask about this site"
msgstr "اسأل عن هذا الموقع"


msgid "Ask a question about this site"
msgstr "اطرح سؤالاً عن هذا الموقع"


msgid "Close"
msgstr "إغلاق"


msgid "Your question"
msgstr "سؤالك"


msgid "Ask about your data…"
msgstr "اسأل عن بياناتك…"


msgid "Send"
msgstr "إرسال"


msgid "The assistant is not available for your account"
msgstr "المساعد غير متاح لحسابك"


msgid "Ask an administrator to add your role to the chat roles in Albanna Settings."
msgstr "اطلب من أحد المشرفين إضافة دورك إلى أدوار المحادثة في إعدادات ألبانا."


msgid "Conversations"
msgstr "المحادثات"


msgid "Your questions and answers"
msgstr "أسئلتك وإجاباتها"


msgid "Back to the conversation"
msgstr "العودة إلى المحادثة"


msgid "Loading…"
msgstr "جارٍ التحميل…"


msgid "No conversations yet"
msgstr "لا توجد محادثات بعد"


msgid "Questions you ask will be listed here."
msgstr "ستُدرج الأسئلة التي تطرحها هنا."


msgid "Conversation title"
msgstr "عنوان المحادثة"


msgid "Rename"
msgstr "إعادة تسمية"


msgid "Delete"
msgstr "حذف"


msgid "New conversation"
msgstr "محادثة جديدة"


msgid "Could not load the conversations."
msgstr "تعذّر تحميل المحادثات."


msgid "Could not open that conversation."
msgstr "تعذّر فتح تلك المحادثة."


msgid "Could not rename that conversation."
msgstr "تعذّرت إعادة تسمية تلك المحادثة."


msgid "Could not delete that conversation."
msgstr "تعذّر حذف تلك المحادثة."


msgid "Ask a question."
msgstr "اطرح سؤالاً."


msgid "Thinking"
msgstr "أفكّر…"


msgid "The chat is switched off on this site."
msgstr "المحادثة معطّلة على هذا الموقع."


msgid "The assistant did not finish this question — the background worker did not complete the turn. It may have been restarted. Please try again."
msgstr "لم يُكمل المساعد هذا السؤال — لم يُكمل العامل الخلفي الدور. ربما أُعيد تشغيله. يرجى المحاولة مرة أخرى."


msgid "You do not have access to the chat. Ask an administrator to add your role."
msgstr "ليس لديك صلاحية استخدام المحادثة. اطلب من أحد المشرفين إضافة دورك."


msgid "Too many questions. Wait a minute and try again."
msgstr "أسئلة كثيرة جداً. انتظر دقيقة ثم حاول مرة أخرى."


msgid "A conversation is required."
msgstr "المحادثة مطلوبة."


msgid "A title is required."
msgstr "العنوان مطلوب."


msgid "That conversation does not exist."
msgstr "تلك المحادثة غير موجودة."


msgid "That conversation belongs to somebody else."
msgstr "تلك المحادثة تخصّ شخصاً آخر."


msgid "A conversation's owner cannot be changed."
msgstr "لا يمكن تغيير مالك المحادثة."

msgid "The value in {0} is stored in plain text. Clear the field, save, and enter the key again."
msgstr "القيمة في {0} مخزّنة كنص صريح. امسح الحقل واحفظ ثم أعد إدخال المفتاح."

msgid "Something went wrong."
msgstr "حدث خطأ ما."


msgid "The request could not be completed."
msgstr "تعذّر إتمام الطلب."


msgid "No answer."
msgstr "لا توجد إجابة."


msgid "Stop"
msgstr "إيقاف"


msgid "Stopped."
msgstr "تم الإيقاف."


msgid "Try again"
msgstr "أعد المحاولة"


msgid "Copy the answer"
msgstr "نسخ الإجابة"


msgid "Jump to the latest"
msgstr "انتقل إلى الأحدث"


msgid "Enter to send · Shift+Enter for a new line"
msgstr "Enter للإرسال · Shift+Enter لسطر جديد"


msgid "Which Sales Orders are still open?"
msgstr "ما أوامر البيع التي ما زالت مفتوحة؟"


msgid "What is the total value of open orders?"
msgstr "ما القيمة الإجمالية للأوامر المفتوحة؟"


msgid "How many customers are there?"
msgstr "كم عدد العملاء؟"


msgid "A new conversation was started."
msgstr "تم بدء محادثة جديدة."


msgid "Could not start a new conversation."
msgstr "تعذّر بدء محادثة جديدة."


msgid "Delete the conversation “{0}”? This cannot be undone."
msgstr "حذف المحادثة «{0}»؟ لا يمكن التراجع عن ذلك."


msgid "Tools used: {0} · Calls: {1}"
msgstr "الأدوات المستخدمة: {0} · الاستدعاءات: {1}"


msgid "failed"
msgstr "فشل"


msgid "Searching"
msgstr "يبحث"


msgid "Reading"
msgstr "يقرأ"


msgid "Checking fields"
msgstr "يتحقق من الحقول"


msgid "Running a report"
msgstr "يشغّل تقريراً"


msgid "Creating"
msgstr "يُنشئ"


msgid "Working"
msgstr "يعمل"


msgid "Calling the provider…"
msgstr "جارٍ الاتصال بالمزوّد…"

msgid "Choose a provider."
msgstr "اختر مزوّداً."

msgid "Dismiss"
msgstr "إغلاق"

msgid "Testing…"
msgstr "جارٍ الاختبار…"

msgid "The conversation was deleted."
msgstr "تم حذف المحادثة."

msgid "The provider answered"
msgstr "استجاب المزوّد"

msgid "The provider could not be called"
msgstr "تعذّر الاتصال بالمزوّد"

msgid "The provider did not answer"
msgstr "لم يستجب المزوّد"

msgid "The provider needs a base URL."
msgstr "يحتاج المزوّد إلى عنوان أساسي."

msgid "The provider needs a model id."
msgstr "يحتاج المزوّد إلى معرّف نموذج."

msgid "These are not roles: {0}"
msgstr "هذه ليست أدواراً: {0}"

msgid "The provider is not one this app knows: {0}"
msgstr "المزوّد ليس واحداً يعرفه هذا التطبيق: {0}"

msgid "Took {0} seconds"
msgstr "استغرق {0} ثانية"

msgid "Unknown error."
msgstr "خطأ غير معروف."


msgid "Asking about {0} {1}"
msgstr "أسأل عن {0} {1}"

msgid "Summarise this {0}"
msgstr "لخّص {0}"

msgid "What is the status of this {0}?"
msgstr "ما حالة {0}؟"

msgid "What is the total of this {0}?"
msgstr "ما الإجمالي لـ {0}؟"


msgid "Copy the table"
msgstr "نسخ الجدول"

msgid "Copy table"
msgstr "نسخ الجدول"

msgid "Copied"
msgstr "تم النسخ"

msgid "There is no table to copy."
msgstr "لا يوجد جدول لنسخه."

msgid "The table could not be copied."
msgstr "تعذّر نسخ الجدول."


msgid "You moved to another page, so the turn was stopped."
msgstr "انتقلت إلى صفحة أخرى، لذلك أُوقف الدور."


msgid "Remove this question and the answer it brought?"
msgstr "هل تريد إزالة هذا السؤال والإجابة التي جاء بها؟"

msgid "Remove this turn"
msgstr "إزالة هذه المحادثة"

msgid "That message does not exist."
msgstr "هذه الرسالة غير موجودة."

msgid "The question and its answer were removed."
msgstr "أُزيل السؤال وإجابته."
