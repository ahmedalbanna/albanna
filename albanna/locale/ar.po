msgstr "المحادثة معطّلة على هذا الموقع."


msgid "The assistant did not finish this question — the background worker did not complete the turn."
msgstr "لم يُكمل المساعد هذا السؤال — لم يُكمل العامل الخلفي الدور."

msgid "Before it stopped, it changed {documents}."
msgstr "قبل أن يتوقف، غيّر {documents}."

msgid "Please check it and try again."
msgstr "يرجى التحقق منه والمحاولة مرة أخرى."

msgid "Please check them and try again."
msgstr "يرجى التحقق منها والمحاولة مرة أخرى."

msgid "It may have been restarted. Please try again."
msgstr "ربما أُعيد تشغيله. يرجى المحاولة مرة أخرى."

msgid "The change you confirmed did not run: {changes}."
msgstr "التغيير الذي أكّدته لم يُنفَّذ: {changes}."

msgid "The changes you confirmed did not run: {changes}."
msgstr "التغييرات التي أكّدتها لم تُنفَّذ: {changes}."

msgid "Too many questions. Wait a minute and try again."
msgstr "أسئلة كثيرة جداً. انتظر دقيقة ثم حاول مرة أخرى."


msgid "A conversation is required."
msgstr "المحادثة مطلوبة."


msgid "A title is required."
msgstr "العنوان مطلوب."


msgid "That conversation does not exist."
msgstr "تلك المحادثة غير موجودة."


msgid "That conversation belongs to somebody else."
msgstr "تلك المحادثة تخصّ شخصاً آخر."


msgid "A conversation's owner cannot be changed."
msgstr "لا يمكن تغيير مالك المحادثة."


msgid "Something went wrong."
msgstr "حدث خطأ ما."


msgid "The request could not be completed."
msgstr "تعذّر إتمام الطلب."


msgid "No answer."
msgstr "لا توجد إجابة."


