msgstr "إيقاف"


msgid "Stopped."
msgstr "تم الإيقاف."


msgid "Asked from {0}"
msgstr "سُئل من {0}"


msgid "Page Identity"
msgstr "هوية الصفحة"


msgid "The page the turn was asked from, as `view|doctype|name`. Context of the question, not of the thread: the transcript names it when the reader is reading the thread from somewhere else."
msgstr "الصفحة التي سُئل الدور منها، بصيغة `view|doctype|name`. سياق للسؤال لا للمحادثة: يسمّي السجلها عندما يقرأ القارئ المحادثة من مكان آخر."


msgid "Could not start a new conversation."
msgstr "تعذّر بدء محادثة جديدة."


msgid "Try again"
msgstr "أعد المحاولة"


msgid "Copy as Markdown"
msgstr "نسخ كـ Markdown"


msgid "Jump to the latest"
msgstr "انتقل إلى الأحدث"


msgid "Enter to send or stop · Shift+Enter for a new line"
msgstr "Enter للإرسال أو الإيقاف · Shift+Enter لسطر جديد"

msgid "Your question is {0} characters; the limit is {1}."
msgstr "سؤالك {0} حرفاً؛ الحد الأقصى {1}."

msgid "Your question is {0} characters; the limit is {1}. Shorten it, or attach the detail as a file."
msgstr "سؤالك {0} حرفاً؛ الحد الأقصى {1}. اختصره، أو أرفق التفاصيل كملف."

msgid "{0} of {1} characters"
msgstr "{0} من {1} حرف"






